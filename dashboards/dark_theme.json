{
  "name": "Obsidian Dark Executive Analytics",
  "dataColors": [
    "#00D2D3",
    "#FF9F43",
    "#54A0FF",
    "#10AC84",
    "#EE5253",
    "#5F27CD",
    "#01CBC6",
    "#FF6B6B"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#1E293B",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 60
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
